# API Configuration
API_PREFIX=/api/v1

# Application Settings
APP_NAME=AI News Review API
APP_VERSION=0.1.0
ENVIRONMENT=development

# CORS Origins
REACT_DEV_ORIGIN=http://localhost:3000
REACT_VITE_ORIGIN=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=true

# Database Configuration - SQLite (Development)
# DATABASE_URL=sqlite:///./veille_sportive.db
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/veille_sportive4?charset=utf8mb4

# MySQL Configuration (Production - COMMENTED OUT)
# To use MySQL, uncomment below and ensure MySQL is running:
MYSQL_DRIVER=mysql+pymysql
MYSQL_host = localhost 
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=veille_sportive4
MYSQL_CHARSET=utf8mb4

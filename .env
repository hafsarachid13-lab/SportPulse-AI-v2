APP_NAME=AI News Review API
APP_VERSION=0.1.0
ENVIRONMENT=development

# Keep empty to expose endpoints as /news and /review.
API_PREFIX=

# React dev servers (CRA and Vite)
REACT_DEV_ORIGIN=http://localhost:3000
REACT_VITE_ORIGIN=http://localhost:5173
REACT_VITE_ORIGIN=http://localhost:8080

# CORS configuration used by backend/config.py
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# SMTP configuration for account emails
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=idsmery25@gmail.com
SMTP_PASSWORD=jbibsohjgwlyaqfg
SMTP_FROM_EMAIL=idsmery25@gmail.com

SMTP_FROM_NAME=AI News Review
SMTP_USE_TLS=true
SMTP_USE_SSL=false

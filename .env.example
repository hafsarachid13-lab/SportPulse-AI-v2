APP_NAME=AI News Review API
APP_VERSION=0.1.0
ENVIRONMENT=development

# Keep empty to expose endpoints as /news and /review.
API_PREFIX=

# React dev servers (CRA and Vite)
REACT_DEV_ORIGIN=http://localhost:3000
REACT_VITE_ORIGIN=http://localhost:5173
REACT_VITE_ORIGIN=http://localhost:8080

# CORS configuration used by backend/config.py
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Database configuration (MySQL / XAMPP)
# If DATABASE_URL is set, it takes priority over MYSQL_*.
# Example:
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/veille_sportive?charset=utf8mb4
DATABASE_URL=
MYSQL_DRIVER=mysql+pymysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=veille_sportive
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
